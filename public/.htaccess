# Gerlach Immobilien Gruppe — static SPA hosting (Apache)
# This is a client-side routed React app (Vite build). Any request that
# isn't a real file/directory on disk must fall through to index.html so
# that deep links like /dashboard/brandbook work on direct load/refresh.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files/directories (assets, favicon, api.php, ...) serve as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else goes through the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Hashed build assets (dist/assets/*) are safe to cache forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|jpe?g|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Vite outputs directory listings-free hashed filenames; block listing anyway.
Options -Indexes
